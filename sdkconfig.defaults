# Enable automatic OTA rollback:
# if the firmware does not call esp_ota_mark_app_valid_cancel_rollback()
# before the next reboot, the bootloader reverts to the previous firmware.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Increase mbedTLS receive buffer from 16 KB (default) to 32 KB.
# BambuLab's periodic mc_print reports are ~16.8 KB and exceed the default
# TLS record limit, causing INVALID_RECORD errors, heap corruption and
# Guru Meditation crashes.
# NOTE: only takes effect when using framework = espidf (or espidf,arduino).
# With the pre-built Arduino framework mbedTLS is compiled at 16 KB and this is ignored.
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=32768
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
